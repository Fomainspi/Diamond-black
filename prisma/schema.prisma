generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SurveyQuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  DROPDOWN
  RATING
  STAR_RATING
  LINEAR_SCALE
  YES_NO
  EMAIL
  NUMBER
  DATE
}

model EventRegistration {
  id                String             @id @default(cuid())
  fullName          String
  email             String
  phone             String
  company           String?
  guests            Int                @default(1)
  consent           Boolean            @default(false)
  eventName         String             @default("100 People · One Night")
  status            RegistrationStatus @default(CONFIRMED)
  confirmationEmail EmailStatus        @default(PENDING)
  notificationEmail EmailStatus        @default(PENDING)
  emailError        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([email])
  @@index([createdAt])
  @@index([status])
}

model AdminUser {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         AdminRole     @default(SUPER_ADMIN)
  active       Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AdminSession[]
  auditLogs    AuditLog[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model ContentEntry {
  id          String        @id @default(cuid())
  type        String
  title       String
  slug        String        @unique
  excerpt     String?
  body        String        @db.Text
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type, status])
  @@index([publishedAt])
}

model ManagedEvent {
  id                  String        @id @default(cuid())
  title               String
  slug                String        @unique
  summary             String?
  description         String        @db.Text
  venue               String?
  location            String?
  startsAt            DateTime
  endsAt              DateTime?
  imageUrl            String?
  registrationEnabled Boolean       @default(true)
  registrationUrl     String?
  status              ContentStatus @default(DRAFT)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status, startsAt])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String   @unique
  altText      String?
  createdAt    DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Survey {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  subtitle       String?
  description    String        @db.Text
  eventName      String
  coverImage     String?
  startsAt       DateTime?
  endsAt         DateTime?
  status         SurveyStatus  @default(DRAFT)
  thankYou       String        @db.Text
  privacyNotice  String?       @db.Text
  currentVersion Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sections       SurveySection[]
  versions       SurveyVersion[]
  responses      SurveyResponse[]

  @@index([status, startsAt])
  @@index([createdAt])
}

model SurveySection {
  id          String           @id @default(cuid())
  surveyId    String
  title       String
  description String?          @db.Text
  sortOrder   Int              @default(0)
  enabled     Boolean          @default(true)
  survey      Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questions   SurveyQuestion[]

  @@index([surveyId, sortOrder])
}

model SurveyQuestion {
  id          String             @id @default(cuid())
  sectionId   String
  title       String
  description String?            @db.Text
  type        SurveyQuestionType
  required    Boolean            @default(false)
  enabled     Boolean            @default(true)
  sortOrder   Int                @default(0)
  minValue    Int?
  maxValue    Int?
  section     SurveySection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options     SurveyQuestionOption[]

  @@index([sectionId, sortOrder])
}

model SurveyQuestionOption {
  id         String         @id @default(cuid())
  questionId String
  label      String
  value      String
  sortOrder  Int            @default(0)
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, sortOrder])
}

model SurveyVersion {
  id          String           @id @default(cuid())
  surveyId    String
  version     Int
  snapshot    Json
  publishedAt DateTime         @default(now())
  survey      Survey           @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  responses   SurveyResponse[]

  @@unique([surveyId, version])
  @@index([surveyId, publishedAt])
}

model SurveyResponse {
  id             String                  @id @default(cuid())
  surveyId       String
  versionId      String
  answers        SurveyAnswer[]
  marketingOptIn Boolean                 @default(false)
  createdAt      DateTime                @default(now())
  survey         Survey                  @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  version        SurveyVersion           @relation(fields: [versionId], references: [id], onDelete: Restrict)
  marketing      SurveyMarketingConsent?

  @@index([surveyId, createdAt])
  @@index([versionId])
}

model SurveyAnswer {
  id           String         @id @default(cuid())
  responseId   String
  questionId   String
  questionText String
  answer       Json
  response     SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([questionId])
}

model SurveyMarketingConsent {
  id         String         @id @default(cuid())
  responseId String         @unique
  email      String
  consentAt  DateTime       @default(now())
  source     String         @default("SURVEY")
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([consentAt])
}

model AuditLog {
  id         String     @id @default(cuid())
  adminId    String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime   @default(now())
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
}
