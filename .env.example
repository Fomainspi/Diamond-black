# Local development placeholders. Never commit .env.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/diamond_black_dev
POSTGRES_PASSWORD=replace-with-local-development-password
# One-time administrator provisioning. Remove password immediately after seed succeeds.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Diamond Black Administrator
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_14_CHARACTERS
MAIL_HOST=smtp.titan.email
MAIL_PORT=465
MAIL_USER=your-mailbox@diamondblack-ph.com
MAIL_PASSWORD=replace-me
MAIL_FROM_NAME=Diamond Black Corporation
MAIL_FROM_ADDRESS=your-mailbox@diamondblack-ph.com
CONTACT_NOTIFICATION_EMAIL=your-mailbox@diamondblack-ph.com
EVENT_NOTIFICATION_EMAIL=your-mailbox@diamondblack-ph.com
NEWSLETTER_PROVIDER=disabled
NEWSLETTER_API_KEY=replace-me
NEWSLETTER_AUDIENCE_ID=replace-with-audience-id
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
SITE_ADDRESS=localhost
ACME_EMAIL=operations@example.com
