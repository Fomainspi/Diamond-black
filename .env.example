# Copy to .env for local development. Never commit .env.
# All values below are examples/placeholders, not working credentials.

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Database: fill locally with your own development database credentials.
# Never use production credentials on a developer machine.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/diamond_black_dev

# Authentication/session secrets: replace locally with randomly generated values.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
# Optional, if the selected framework requires a separate CSRF secret:
CSRF_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Email provider configuration. Keep all real credentials outside Git.
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USER=replace-me
MAIL_PASSWORD=replace-me
MAIL_FROM_NAME=Diamond Black Corporation
MAIL_FROM_ADDRESS=no-reply@example.com
CONTACT_NOTIFICATION_EMAIL=contact@example.com

# Newsletter provider, if an external provider is selected.
NEWSLETTER_PROVIDER=disabled
NEWSLETTER_API_KEY=replace-me

# Public social URLs should be set to verified official accounts only.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Event registration URL: leave empty until the official registration destination is confirmed.
FEATURED_EVENT_REGISTRATION_URL=

# Caddy reverse proxy. Use your real domain only after DNS is configured.
SITE_ADDRESS=localhost
ACME_EMAIL=replace-with-an-approved-operations-email@example.com
